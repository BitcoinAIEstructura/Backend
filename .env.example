# Variables de entorno del backend (todas opcionales). Copia lo que necesites a tu
# entorno o al panel de Railway. Nunca subas a git valores reales de CLAVE_CIFRADO.

# Puerto HTTP (Railway lo pone solo; no lo definas allí).
PORT=8080

# Mercado
BINANCE_BASE_URL=https://api.binance.com
SIMBOLO=BTCUSDT
TTL_CACHE_SEGUNDOS=30

# Frontend que puede llamar a la API con la cookie de sesión (URL exacta, nunca *).
ORIGEN_PERMITIDO=http://localhost:3000

# Datos: simulación en JSON y base SQLite de usuarios.
DATA_DIR=./data
# BASE_DATOS=./data/bitcoinai.db

# Secreta: 32 bytes en base64. Si falta, en localhost se genera data/clave-cifrado.key.
# Generar: python -c "from bitcoinai.seguridad.claves import generar_clave_texto as g; print(g())"
# CLAVE_CIFRADO=

# En producción con HTTPS (Railway): true y true.
COOKIE_SEGURA=false
CONFIAR_PROXY=false

# Correos (el código para confirmar el correo al crear la cuenta).
# SMTP_USUARIO es la cuenta DESDE la que salen los correos, no a quién le llegan: el código
# siempre va al correo que escribe cada persona al registrarse (Gmail, Hotmail, Outlook, Yahoo,
# el de la universidad...). Basta una sola cuenta de Gmail para todo el proyecto.
# Sin estas dos variables, los correos se guardan como archivos .eml en DATA_DIR/correos.
# Para Gmail: SMTP_CONTRASENA es una "contraseña de aplicación" (Cuenta de Google → Seguridad →
# Verificación en dos pasos → Contraseñas de aplicaciones), no la contraseña normal.
# Gmail deja enviar unos 500 correos al día; para más, usa otro servicio SMTP (Brevo, SendGrid...)
# cambiando SMTP_HOST, SMTP_PUERTO, SMTP_USUARIO y SMTP_CONTRASENA.
# Ponlas en un archivo .env (no se sube a git): el servidor lo lee al arrancar.
# SMTP_USUARIO=nexabit.proyecto@gmail.com
# SMTP_CONTRASENA=
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=587
# Con Gmail, déjalo vacío (sale de SMTP_USUARIO): otro remitente hace que el correo llegue a spam.
# CORREO_REMITENTE=

# Conexiones simultáneas a /api/stream.
MAX_STREAMS=50

# Bots simulados encendidos a la vez entre todos los usuarios.
MAX_BOTS=20

# Límite de peticiones por minuto y por IP: general y rutas costosas (IA).
LIMITE_GENERAL=600
LIMITE_COSTOSAS=30
