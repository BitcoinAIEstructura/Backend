# Variables de entorno del backend (todas opcionales). Copia lo que necesites a tu
# entorno o al panel de Railway. Nunca subas a git valores reales de CLAVE_CIFRADO.

# Puerto HTTP (Railway lo pone solo; no lo definas allí).
PORT=8080

# Mercado
BINANCE_BASE_URL=https://api.binance.com
SIMBOLO=BTCUSDT
TTL_CACHE_SEGUNDOS=30

# Frontend que puede llamar a la API con la cookie de sesión (URL exacta, nunca *).
ORIGEN_PERMITIDO=http://localhost:3000

# Datos: simulación en JSON y base SQLite de usuarios.
DATA_DIR=./data
# BASE_DATOS=./data/bitcoinai.db

# Secreta: 32 bytes en base64. Si falta, en localhost se genera data/clave-cifrado.key.
# Generar: python -c "from bitcoinai.seguridad.claves import generar_clave_texto as g; print(g())"
# CLAVE_CIFRADO=

# En producción con HTTPS (Railway): true y true.
COOKIE_SEGURA=false
CONFIAR_PROXY=false

# Conexiones simultáneas a /api/stream.
MAX_STREAMS=50
